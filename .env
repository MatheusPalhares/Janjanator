# ============================================================================
# Configuração do Servidor LiveKit (Docker Self-Hosted)
# ============================================================================

# Porta HTTP/WebSocket de Sinalização
LIVEKIT_PORT=7880

# Porta WebRTC fallback TCP
LIVEKIT_TCP_PORT=7881

# Credenciais Privadas da Sala (Sincronizadas com livekit.yaml e Cliente Nativo)
LIVEKIT_API_KEY=APIScreenSharePrivateKey
LIVEKIT_API_SECRET=SecretScreenShareKeyForFriends2026Win11Native!

# Nome da sala padrão
LIVEKIT_DEFAULT_ROOM=sala-principal

